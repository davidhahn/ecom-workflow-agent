  "actual_answer": null,
  "response_status": "success",
  "generated_sql": "SELECT r.reason, ROUND(CAST(AVG(EXTRACT(EPOCH FROM (r.requested_at - o.order_date)) / 86400) AS DECIMAL), 2) AS avg_days_to_refund_request, COUNT(r.id) AS total_refund_requests FROM refunds AS r JOIN order_items AS oi ON r.order_item_id = oi.id JOIN orders AS o ON oi.order_id = o.id GROUP BY r.reason ORDER BY avg_days_to_refund_request DESC LIMIT 500",
