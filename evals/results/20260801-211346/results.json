      "id": "sql-01-refund-rate-by-category",
      "category": "sql",
      "passed": true,
      "expected": {
        "tables_joined": [
          "order_items",
          "products",
          "refunds"
        ],
        "columns_excluded": [
          "customers.email"
        ],
        "read_only_violation_attempt": false,
        "expected_status": "success"
      },
      "actual": {
        "status": "success",
        "sql_executed": "SELECT COUNT(DISTINCT r.id) AS total_refunds, COUNT(DISTINCT oi.id) AS total_order_items, ROUND(CAST(COUNT(DISTINCT r.id) * 100.0 / NULLIF(COUNT(DISTINCT oi.id), 0) AS DECIMAL), 2) AS refund_rate_pct FROM products AS p JOIN order_items AS oi ON oi.product_id = p.id LEFT JOIN refunds AS r ON r.order_item_id = oi.id WHERE p.category = 'Electronics' LIMIT 500"
      },
      "failure_reasons": [],
      "latency_ms": 3385.2254590019584,
      "cost_usd": 0.006732
    },
    {
      "id": "sql-03-avg-days-to-refund-by-reason",
      "category": "sql",
      "passed": true,
      "expected": {
        "tables_joined": [
          "orders",
          "order_items",
          "refunds"
        ],
        "columns_excluded": [
          "customers.email"
        ],
        "read_only_violation_attempt": false,
        "expected_status": "success"
      },
      "actual": {
        "status": "success",
        "sql_executed": "SELECT r.reason, ROUND(CAST(AVG(EXTRACT(EPOCH FROM (r.requested_at - o.order_date)) / 86400) AS DECIMAL), 2) AS avg_days_to_refund_request, COUNT(r.id) AS total_refunds FROM refunds AS r JOIN order_items AS oi ON r.order_item_id = oi.id JOIN orders AS o ON oi.order_id = o.id GROUP BY r.reason ORDER BY avg_days_to_refund_request DESC LIMIT 500"
      },
      "failure_reasons": [],
      "latency_ms": 3571.988624986261,
      "cost_usd": 0.00663
    },
