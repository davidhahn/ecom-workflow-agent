DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_ops
ANTHROPIC_API_KEY=sk-ant-replace-me

# Password for the restricted ops_agent_readonly Postgres role (SQL query path,
# layer 3). Required before running the role-creation migration.
OPS_AGENT_DB_PASSWORD=replace-me

# Optional: overrides for the SQL query path (see app/query/).
# ANTHROPIC_MODEL=claude-sonnet-4-6
# QUERY_COST_THRESHOLD=10000

# Embedding provider for app/rag/embeddings.py (see DECISIONS.md #8).
# "local" (default, no key needed) uses BAAI/bge-m3 via sentence-transformers.
# "voyage" uses the hosted Voyage AI API and requires VOYAGE_API_KEY below.
# EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=pa-replace-me
