NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret middleware.ts injects on every /api/* proxied request (see
# apps/api/app/proxy_secret.py). Server-side only — deliberately not
# prefixed NEXT_PUBLIC_, never exposed to the client. Must match the
# backend's INTERNAL_PROXY_SECRET exactly. In deploy, set identically in
# both Render's and Vercel's dashboards (see README.md's Deployment section).
INTERNAL_PROXY_SECRET=replace-me
